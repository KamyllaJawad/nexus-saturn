erDiagram
  TRIPULANTE ||--o{ LEITURA : gera
  TRIPULANTE ||--o{ CONSENTIMENTO : concede
  TRIPULANTE ||--o{ EVENTO : envolve
  LEITURA }o--o| EVENTO : abre
  EVENTO ||--o{ SUGESTAO : recebe
  EVENTO ||--o{ DECISAO : recebe
  EVENTO ||--o{ PACOTE : vira
  PERFIL_MISSAO ||--o{ PACOTE : define_atraso
  EVENTO ||--o{ REGISTRO_AUDITORIA : registra

  TRIPULANTE {
    string id PK
    string nome
    string papel
    json linha_de_base
  }
  LEITURA {
    string id PK
    string tripulante_id FK
    string metrica
    float valor
    string unidade
    string fonte_sensor
    float qualidade_sinal
    datetime gerada_em
  }
  EVENTO {
    string id PK
    string tipo
    string estado
    int nivel_autonomia
    string papel_responsavel
    datetime prazo_em
    datetime gerado_em
  }
  SUGESTAO {
    string id PK
    string evento_id FK
    string texto
    json evidencias
    float confianca
    string alternativa
    string versao_modelo
  }
  DECISAO {
    string id PK
    string evento_id FK
    string humano_id FK
    string acao
    string dose
    string assinatura
    datetime decidida_em
  }
  CONSENTIMENTO {
    string id PK
    string tripulante_id FK
    string tipo_dado
    string destinatario
    datetime valido_ate
    datetime revogado_em
  }
  PACOTE {
    string id PK
    int prioridade
    string destino
    string estado
    datetime gerado_em
    datetime enviado_em
    datetime confirmado_em
  }
  REGISTRO_AUDITORIA {
    int seq PK
    string entidade
    string de_estado
    string para_estado
    string ator
    datetime quando
    string hash_anterior
    string hash
  }
  PERFIL_MISSAO {
    string id PK
    float atraso_ida_s
    string link
    json janelas_previstas
  }
